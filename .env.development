# RakthaSethu Local Development Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local zero-config SQLite database
DATABASE_URL=file:./dev.db

# Development JWT Secrets
JWT_ACCESS_SECRET=rakthasethu_dev_access_secret_key_1234567890_change_in_prod
JWT_REFRESH_SECRET=rakthasethu_dev_refresh_secret_key_0987654321_change_in_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Development Notifications (Mock / Log to console)
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

ENABLE_AI_FEATURES=true
AI_MODEL=gemini-1.5-flash
