generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  phone            String?           @unique
  role             String            @default("DONOR")
  isActive         Boolean           @default(true)
  isVerified       Boolean           @default(false)
  lastLogin        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  refreshTokens    RefreshToken[]
  verificationTokens VerificationToken[]
  donorProfile     DonorProfile?
  patientProfile   PatientProfile?
  hospitalProfile  Hospital?
  bloodBankProfile BloodBank?
  volunteerProfile Volunteer?
  auditLogs        AuditLog[]
  notifications    Notification[]
  bloodRequests    BloodRequest[]    @relation("UserBloodRequests")
  organizedCampaigns Campaign[]      @relation("OrganizerCampaigns")
  bloodReceipts    BloodReceipt[]
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreference?

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model DonorProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  dateOfBirth          DateTime
  gender               String
  bloodGroup           String
  city                 String
  state                String
  address              String
  latitude             Float?
  longitude            Float?
  lastDonationDate     DateTime?
  isEligible           Boolean       @default(true)
  isAvailable          Boolean       @default(true)
  emergencyAvailable   Boolean       @default(true)
  totalDonations       Int           @default(0)
  livesSavedEstimate   Int           @default(0)
  impactScore          Int           @default(0)
  badges               String        @default("[]")
  availabilityStatus   String        @default("AVAILABLE")
  consentGiven         Boolean       @default(true)
  hidePhoneNumber      Boolean       @default(false)
  hideExactAddress     Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  matches              DonorMatch[]
  donations            Donation[]
  campaignRegistrations CampaignRegistration[]

  @@index([bloodGroup])
  @@index([city, state])
  @@index([isAvailable, isEligible])
  @@index([isAvailable, isEligible, bloodGroup])
  @@index([isAvailable, emergencyAvailable])
  @@index([availabilityStatus])
}

model PatientProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  dateOfBirth          DateTime?
  gender               String?
  bloodGroup           String?
  emergencyContactName String?
  emergencyContactPhone String?
  city                 String
  state                String
  address              String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Hospital {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  licenseNumber        String             @unique
  address              String
  city                 String
  state                String
  latitude             Float?
  longitude            Float?
  contactPerson        String
  contactPhone         String
  verificationStatus   String             @default("PENDING")
  verificationNotes    String?
  verifiedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  donations            Donation[]

  @@index([city, state])
  @@index([verificationStatus])
}

model BloodBank {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  licenseNumber        String             @unique
  address              String
  city                 String
  state                String
  latitude             Float?
  longitude            Float?
  contactPerson        String
  contactPhone         String
  storageCapacity      Int                @default(1000)
  verificationStatus   String             @default("PENDING")
  verificationNotes    String?
  verifiedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  inventory            BloodInventory[]
  donations            Donation[]

  @@index([city, state])
  @@index([verificationStatus])
}

model Volunteer {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  serviceAreaCity      String
  serviceAreaState     String
  isAvailable          Boolean       @default(true)
  skills               String?
  totalTasksCompleted  Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([serviceAreaCity, serviceAreaState])
}

model BloodRequest {
  id                   String        @id @default(uuid())
  requesterId          String
  requester            User          @relation("UserBloodRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  patientName          String
  patientAge           Int?
  patientGender        String?
  bloodGroup           String
  unitsRequired        Int           @default(1)
  hospitalName         String
  hospitalCity         String
  hospitalState        String
  hospitalAddress      String
  latitude             Float?
  longitude            Float?
  requiredBy           DateTime
  urgency              String        @default("NORMAL")
  medicalReason        String?
  contactName          String
  contactPhone         String
  status               String        @default("PENDING")
  unitsFulfilled       Int           @default(0)
  additionalNotes      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  matches              DonorMatch[]
  donations            Donation[]
  receipts             BloodReceipt[]
  searches             EmergencySearch[]
  coordinationRoom     EmergencyCoordinationRoom?

  @@index([bloodGroup])
  @@index([hospitalCity, hospitalState])
  @@index([status])
  @@index([urgency])
  @@index([status, urgency, createdAt])
  @@index([bloodGroup, hospitalCity, status])
}

model DonorMatch {
  id                   String        @id @default(uuid())
  requestId            String
  request              BloodRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorId              String
  donor                DonorProfile  @relation(fields: [donorId], references: [id], onDelete: Cascade)
  compatibilityScore   Float
  distanceKm           Float?
  status               String        @default("PENDING")
  contactedAt          DateTime      @default(now())
  respondedAt          DateTime?
  startedTravellingAt  DateTime?
  arrivedAt            DateTime?
  responseNotes        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([requestId, donorId])
  @@index([status])
}

model Donation {
  id                   String        @id @default(uuid())
  donorId              String
  donor                DonorProfile  @relation(fields: [donorId], references: [id], onDelete: Cascade)
  requestId            String?
  request              BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  hospitalId           String?
  hospital             Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodBankId          String?
  bloodBank            BloodBank?    @relation(fields: [bloodBankId], references: [id], onDelete: SetNull)
  bloodGroup           String
  units                Int           @default(1)
  donationDate         DateTime      @default(now())
  certificateCode      String        @unique
  status               String        @default("CONFIRMED")
  startedAt            DateTime?
  completedAt          DateTime?
  verifiedAt           DateTime?
  verifiedBy           String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([donorId])
  @@index([donationDate])
  @@index([status])
}

model BloodReceipt {
  id                   String        @id @default(uuid())
  requestId            String
  request              BloodRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  receiverId           String
  receiver             User          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  unitsReceived        Int           @default(1)
  confirmed            Boolean       @default(false)
  confirmedAt          DateTime?
  reportedIssue        String?
  notes                String?
  createdAt            DateTime      @default(now())

  @@index([requestId])
  @@index([receiverId])
}

model BloodInventory {
  id                   String          @id @default(uuid())
  bloodBankId          String
  bloodBank            BloodBank       @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  bloodGroup           String
  componentType        String          @default("WHOLE_BLOOD")
  units                Int             @default(0)
  batchNumber          String
  collectionDate       DateTime
  expiryDate           DateTime
  status               String          @default("AVAILABLE")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([bloodBankId, bloodGroup])
  @@index([bloodBankId, bloodGroup, expiryDate])
  @@index([expiryDate])
  @@index([status])
}

model Notification {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  message              String
  type                 String                 @default("SYSTEM_NOTICE")
  priority             String                 @default("NORMAL")
  category             String?                @default("GENERAL")
  link                 String?
  actionUrl            String?
  metadata             String?
  relatedRequestId     String?
  relatedDonationId    String?
  relatedHospitalId    String?
  relatedBloodBankId   String?
  isRead               Boolean                @default(false)
  readAt               DateTime?
  expiresAt            DateTime?
  deliveryChannel      String?                @default("IN_APP")
  createdAt            DateTime               @default(now())

  deliveries           NotificationDelivery[]

  @@index([userId, isRead])
  @@index([priority])
  @@index([createdAt])
  @@index([relatedRequestId])
}

model PushSubscription {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String                 @unique
  p256dh          String
  auth            String
  userAgent       String?
  deviceType      String?                @default("DESKTOP")
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  failureCount    Int                    @default(0)
  revokedAt       DateTime?

  deliveries      NotificationDelivery[]

  @@index([userId, isActive])
  @@index([endpoint])
}

model NotificationDelivery {
  id              String            @id @default(uuid())
  notificationId  String
  notification    Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    PushSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status          String            @default("QUEUED")
  attemptedAt     DateTime          @default(now())
  deliveredAt     DateTime?
  clickedAt       DateTime?
  statusCode      Int?
  errorCode       String?
  errorMessage    String?

  @@index([notificationId])
  @@index([subscriptionId])
  @@index([status])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled        Boolean  @default(true)
  soundEnabled       Boolean  @default(true)
  vibrationEnabled   Boolean  @default(true)
  emergencyAlerts    Boolean  @default(true)
  bloodRequests      Boolean  @default(true)
  donationUpdates    Boolean  @default(true)
  systemAlerts       Boolean  @default(true)
  campaignAlerts     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Campaign {
  id                   String                 @id @default(uuid())
  organizerId          String
  organizer            User                   @relation("OrganizerCampaigns", fields: [organizerId], references: [id], onDelete: Cascade)
  title                String
  description          String
  startDate            DateTime
  endDate              DateTime
  location             String
  address              String
  city                 String
  state                String
  latitude             Float?
  longitude            Float?
  bloodGroupsNeeded    String                 @default("ALL")
  targetUnits          Int                    @default(100)
  registeredCount      Int                    @default(0)
  status               String                 @default("UPCOMING")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  registrations        CampaignRegistration[]

  @@index([city, state])
  @@index([startDate])
}

model CampaignRegistration {
  id                   String       @id @default(uuid())
  campaignId           String
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donorId              String
  donor                DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)
  status               String       @default("CONFIRMED")
  registrationDate     DateTime     @default(now())
  attended             Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([campaignId, donorId])
}

model AuditLog {
  id                   String   @id @default(uuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action               String
  entity               String
  entityId             String?
  details              String?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model EmergencySearch {
  id                   String                @id @default(uuid())
  requestId            String
  request              BloodRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  urgency              String                @default("NORMAL")
  currentRadiusKm      Float                 @default(5.0)
  maxRadiusKm          Float                 @default(20.0)
  status               String                @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED" | "ESCALATED"
  targetDonorsNeeded   Int                   @default(5)
  donorsFoundCount     Int                   @default(0)
  donorsContactedCount Int                   @default(0)
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  escalationPlan       String?               // JSON string of AI escalation recommendations
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  radiusAttempts       SearchRadiusAttempt[]

  @@index([requestId])
  @@index([status])
}

model SearchRadiusAttempt {
  id                   String                @id @default(uuid())
  searchId             String
  search               EmergencySearch       @relation(fields: [searchId], references: [id], onDelete: Cascade)
  radiusKm             Float
  donorsFound          Int                   @default(0)
  cumulativeDonors     Int                   @default(0)
  isSufficient         Boolean               @default(false)
  candidateDonorIds    String?               // JSON array of donor IDs
  attemptedAt          DateTime              @default(now())

  @@index([searchId])
}

model EmergencyCoordinationRoom {
  id                   String                @id @default(uuid())
  requestId            String                @unique
  request              BloodRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status               String                @default("ACTIVE") // "ACTIVE" | "RESOLVED" | "ARCHIVED"
  unitsSecured         Int                   @default(0)
  unitsTarget          Int                   @default(1)
  hospitalNotes        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  resolvedAt           DateTime?

  messages             EmergencyMessage[]

  @@index([status])
}

model EmergencyMessage {
  id                   String                     @id @default(uuid())
  roomId               String
  room                 EmergencyCoordinationRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId             String
  senderName           String
  senderRole           String                     // "REQUESTER" | "DONOR" | "HOSPITAL" | "VOLUNTEER" | "SYSTEM"
  message              String
  messageType          String                     @default("TEXT") // "TEXT" | "PREDEFINED" | "STATUS_UPDATE" | "NAVIGATION"
  isPredefined         Boolean                    @default(false)
  createdAt            DateTime                   @default(now())

  @@index([roomId])
  @@index([createdAt])
}

model ModelPrediction {
  id                   String                @id @default(uuid())
  modelType            String                // "DONOR_RESPONSE" | "DEMAND_FORECAST" | "SHORTAGE_RISK" | "REQUEST_TRUST"
  modelVersion         String                @default("1.0.0")
  entityId             String?               // requestId or donorId or bloodBankId
  inputFeatures        String                // JSON string
  predictionOutput     String                // JSON string
  confidence           Float                 @default(1.0)
  actualOutcome        String?               // JSON string when verified
  createdAt            DateTime              @default(now())

  @@index([modelType])
  @@index([entityId])
  @@index([createdAt])
}

model OfflineSyncEvent {
  id                   String                @id @default(uuid())
  idempotencyKey       String                @unique
  userId               String?
  actionType           String                // "CREATE_REQUEST" | "ACCEPT_MATCH" | "UPDATE_STATUS"
  payload              String                // JSON payload
  status               String                @default("PENDING") // "PENDING" | "PROCESSED" | "FAILED"
  resultDetails        String?
  syncedAt             DateTime              @default(now())

  @@index([idempotencyKey])
  @@index([status])
}

