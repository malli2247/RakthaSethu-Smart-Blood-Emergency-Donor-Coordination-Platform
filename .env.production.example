# ==============================================================================
# RAKTHASETHU — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://rakthasethu.in
BACKEND_URL=https://api.rakthasethu.in
CORS_ORIGINS=https://rakthasethu.in,https://admin.rakthasethu.in

# PostgreSQL Production Connection String with connection pooling
DATABASE_URL=postgresql://postgres_user:STRONG_PRODUCTION_PASSWORD@postgres.internal:5432/rakthasethu?sslmode=require&schema=public

# Cryptographically Secure Random JWT Secrets (min 64 chars)
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_GENERATED_64_CHAR_HEX_SECRET_1
JWT_REFRESH_SECRET=REPLACE_WITH_OPENSSL_GENERATED_64_CHAR_HEX_SECRET_2
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Production Email Service (SMTP or Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_production_sendgrid_key
EMAIL_FROM=RakthaSethu <noreply@rakthasethu.in>

# Production SMS / WhatsApp Alerts
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_production_sid
TWILIO_AUTH_TOKEN=your_production_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps API for verified hospital geocoding
GOOGLE_MAPS_API_KEY=AIzaSy_your_restricted_production_maps_key

# Advisory AI
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash
ENABLE_AI_FEATURES=true

# Secure Storage for Hospital Licenses & Proofs
STORAGE_PROVIDER=s3
S3_BUCKET=rakthasethu-production-storage
S3_REGION=ap-south-1
S3_ACCESS_KEY=your_aws_access_key_id
S3_SECRET_KEY=your_aws_secret_access_key
MAX_FILE_SIZE_MB=5
