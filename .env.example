# ==============================================================================
# RAKTHASETHU — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.production and fill in the required values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://rakthasethu.in

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Development: SQLite (zero-config local) or PostgreSQL
# Production: Highly available PostgreSQL 16 connection string
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/rakthasethu?schema=public
# For SQLite development fallback:
# DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------------------
# 3. JWT & SESSION SECURITY (REQUIRED - MUST CHANGE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate 64-character random hex strings using: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_64_char_random_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_64_char_random_hex_string_for_refresh_tokens
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & BRUTE FORCE GUARDS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10 # Stricter limit for /login and /register

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE (OPTIONAL in Dev, REQUIRED in Prod)
# ------------------------------------------------------------------------------
# Supported: SMTP (Nodemailer), Resend, SendGrid
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RakthaSethu Alerts <alerts@rakthasethu.org>
# For Resend or SendGrid:
# EMAIL_API_KEY=re_your_api_key

# ------------------------------------------------------------------------------
# 6. SMS / OTP SERVICE (OPTIONAL in Dev, RECOMMENDED in Prod for emergency alerts)
# ------------------------------------------------------------------------------
# Supported: twilio, fast2sms, mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS & GEOLOCATION (OPTIONAL - Haversine fallback active)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 8. AI LAYER (OPTIONAL - Medical Heuristic Engine active by default)
# ------------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
ENABLE_AI_FEATURES=true

# ------------------------------------------------------------------------------
# 9. FILE UPLOAD & OBJECT STORAGE (OPTIONAL in Dev, RECOMMENDED in Prod)
# ------------------------------------------------------------------------------
# Supported: local, cloudinary, s3
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
# For S3:
# S3_BUCKET=rakthasethu-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# For Cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
