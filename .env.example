# ==============================================================================
# RAKTHASETHU — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Placeholders only. NEVER commit actual production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (BACKEND ONLY)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://rakthasethu.in

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (BACKEND ONLY)
# ------------------------------------------------------------------------------
# Production: Highly available PostgreSQL 16 connection string with SSL
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/rakthasethu?schema=public

# ------------------------------------------------------------------------------
# 3. JWT & SESSION SECURITY (BACKEND ONLY - MUST GENERATE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate 64-character random hex strings using: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_64_char_random_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_64_char_random_hex_string_for_refresh_tokens
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & SECURITY GUARDS (BACKEND ONLY)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (BACKEND ONLY - Clinical Heuristic Fallback Active)
# ------------------------------------------------------------------------------
# Google AI Studio API key (https://aistudio.google.com/)
GEMINI_API_KEY=
AI_API_KEY= # Legacy alias for GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
ENABLE_AI_FEATURES=true

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (Haversine & OpenStreetMap Active by Default)
# ------------------------------------------------------------------------------
# Server key: Geocoding & Places (BACKEND ONLY - Restrict to backend server IP)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY= # Legacy alias for GOOGLE_MAPS_SERVER_KEY

# Browser key: Interactive maps (FRONTEND ONLY - Restrict to https://rakthasethu.in/*)
# VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE — RESEND / SMTP (BACKEND ONLY)
# ------------------------------------------------------------------------------
# Option A: Resend (Recommended, https://resend.com)
EMAIL_PROVIDER=resend # 'resend' | 'smtp' | 'mock'
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=RakthaSethu Alerts <alerts@rakthasethu.org>

# Option B: SMTP (Nodemailer, e.g. Mailtrap, Amazon SES, SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RakthaSethu Alerts <alerts@rakthasethu.org>

# ------------------------------------------------------------------------------
# 8. MOBILE OTP & SMS — MULTI-PROVIDER (BACKEND ONLY)
# ------------------------------------------------------------------------------
# Supported: 'twilio' | 'fast2sms' | 'msg91' | 'gateway' | 'mock'
OTP_PROVIDER=mock # Set to 'twilio', 'fast2sms', or 'msg91' in production
SMS_PROVIDER=mock # Alias for OTP_PROVIDER

# Provider 1: Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional dedicated Twilio Verify service:
OTP_VERIFY_SERVICE_ID=

# Generic OTP aliases (Twilio compatible):
OTP_ACCOUNT_ID=
OTP_AUTH_TOKEN=

# Provider 2: Fast2SMS (Indian DLT/Quick Route, https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Provider 3: MSG91 (Indian DLT Transactional, https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RKTHST

# Local Dev Override (allows mock OTP in production mode for staging tests)
# OTP_DEV_MODE=true

# ------------------------------------------------------------------------------
# 9. W3C WEB PUSH NOTIFICATIONS & VAPID (BACKEND & FRONTEND)
# ------------------------------------------------------------------------------
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Public key goes to BOTH backend and frontend:
VAPID_PUBLIC_KEY=BD3wUSOHMziCiqA6EoULEnRcC7ouASGCDyyQ_0L7HSImy-ByJqC9ooZsVGGyUnBMPwig_hf5I0FOMtD5IGhtpxA

# Private key & subject (BACKEND ONLY - NEVER expose to browser):
VAPID_PRIVATE_KEY=PO8bjY2xH7m065PJN6pd-61D688dZ_EeYaEEU3Bj9UM
VAPID_SUBJECT=mailto:admin@rakthasethu.org

# ------------------------------------------------------------------------------
# 10. FRONTEND VITE CONFIGURATION (Vercel / Frontend .env ONLY)
# ------------------------------------------------------------------------------
# VITE_API_URL=/api # In Vercel, relative /api or https://api.rakthasethu.org
# VITE_VAPID_PUBLIC_KEY=BD3wUSOHMziCiqA6EoULEnRcC7ouASGCDyyQ_0L7HSImy-ByJqC9ooZsVGGyUnBMPwig_hf5I0FOMtD5IGhtpxA
