# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rakthasethu?schema=public"

# Security & JWT Tokens
JWT_ACCESS_SECRET="rakthasethu_super_secure_access_secret_key_change_in_prod_123"
JWT_REFRESH_SECRET="rakthasethu_super_secure_refresh_secret_key_change_in_prod_456"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Layer (Optional - heuristic fallback active when key is blank)
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
ENABLE_AI_FEATURES=true

# Notification Service Providers (Mock / Architecture)
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="sample_user"
SMTP_PASS="sample_password"
SMTP_FROM="RakthaSethu Notifications <alerts@rakthasethu.org>"
